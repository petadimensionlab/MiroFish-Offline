# =============================================================
# MiroFish-Offline Configuration
# =============================================================
# This fork runs entirely on local models — no cloud APIs needed.
# Copy this file to .env and adjust values for your setup.
# =============================================================

# ===== LLM Configuration (OpenAI-compatible format) =====
# Points to local Ollama server. Any non-empty value for API key works.
# For Docker: use service name "ollama" instead of "localhost"
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL_NAME=qwen2.5:32b
# Lighter model for development (less VRAM):
# LLM_MODEL_NAME=qwen2.5:14b

# ===== Neo4j Configuration =====
# MiroFish runs its own dedicated Neo4j container (mirofish-neo4j, auth
# neo4j/mirofish). If another Neo4j already uses 7474/7687, remap the host
# ports and point NEO4J_URI at the new Bolt port, e.g.:
#   NEO4J_HTTP_PORT=7475
#   NEO4J_BOLT_PORT=7688
#   NEO4J_URI=bolt://localhost:7688
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mirofish
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474

# ===== Embedding Configuration =====
# 'auto' uses Ollama's native /api/embed when EMBEDDING_BASE_URL points at
# *:11434, otherwise the OpenAI-compatible /v1/embeddings endpoint. Set
# explicitly to 'openai' for vLLM/llama.cpp, or 'ollama' to force native.
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_API_STYLE=auto
# Only used by the OpenAI-compatible endpoint (ignored by Ollama).
EMBEDDING_API_KEY=ollama
# For Docker: EMBEDDING_BASE_URL=http://ollama:11434

# ===== OASIS / CAMEL-AI Configuration =====
# CAMEL-AI reads OPENAI_API_KEY and OPENAI_API_BASE_URL
# Points to same local Ollama server
OPENAI_API_KEY=ollama
OPENAI_API_BASE_URL=http://localhost:11434/v1

# ===== Ollama Performance / Parallelism =====
# Ollama supports parallel inference, but defaults to OLLAMA_NUM_PARALLEL=1,
# which serializes requests. Raise it so the simulation's concurrent agent
# calls actually run in parallel.
#
# effective context per model = OLLAMA_CONTEXT_LENGTH * OLLAMA_NUM_PARALLEL
# KV-cache memory scales linearly with that product. On Apple Silicon the KV
# cache shares unified memory with the model weights and the OS.
# Starting points for a 128 GB Mac: NUM_PARALLEL=8..16, CONTEXT_LENGTH=8192.
# Use GGUF models (NOT *-mlx tags) for concurrency: the MLX engine serializes.
# Keep MAX_LOADED_MODELS >= 2 so the chat model and the embedding model stay
# resident together (otherwise each switch reloads the large chat model).
OLLAMA_NUM_PARALLEL=4
OLLAMA_MAX_LOADED_MODELS=2
OLLAMA_MAX_QUEUE=64
OLLAMA_KEEP_ALIVE=30m
OLLAMA_CONTEXT_LENGTH=8192
# Per-request context window: 4K for most steps, full 64K only for ontology
# generation (which may feed up to 50,000 characters).
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_CTX_ONTOLOGY=65536
OLLAMA_NUM_CTX_CONFIG=32768
# Independent work that can run concurrently (uses spare NUM_PARALLEL slots)
CONFIG_BATCH_PARALLEL=8
GRAPH_BUILD_PARALLEL=4
# Optional — lower KV memory/bandwidth (uncomment to enable):
# OLLAMA_FLASH_ATTENTION=1
# OLLAMA_KV_CACHE_TYPE=q8_0
#
# These values are read by:
#   - docker-compose.yml (Ollama service), and
#   - scripts/start_ollama_parallel.sh (local, non-Docker `ollama serve`).
# The macOS Ollama.app ignores shell env; quit it before using the script.

# ===== Remote OpenAI-compatible backend (vLLM etc.), optional =====
# vLLM has no native macOS/Apple Silicon backend. It runs on Linux + NVIDIA
# (CUDA) or AMD (ROCm). The chat API here is OpenAI-compatible, so a remote
# vLLM server works by changing these:
#   LLM_BASE_URL=http://gpu-host:8000/v1
#   LLM_MODEL_NAME=<served-model-name>
#   OPENAI_API_BASE_URL=http://gpu-host:8000/v1
# For embeddings via the same server, also set:
#   EMBEDDING_BASE_URL=http://gpu-host:8000/v1
#   EMBEDDING_API_STYLE=openai
#   EMBEDDING_MODEL=<served-embedding-model>

# ===== Docker-mode overrides =====
# Uncomment these when running ALL services inside Docker
# (backend container talks to neo4j/ollama containers by service name)
# LLM_BASE_URL=http://ollama:11434/v1
# NEO4J_URI=bolt://neo4j:7687
# EMBEDDING_BASE_URL=http://ollama:11434
# OPENAI_API_BASE_URL=http://ollama:11434/v1
